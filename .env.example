# Base URL of the titiler service the frontend fetches raster tiles from.
# This is baked into the static build at build time (Vite/SvelteKit public
# env convention) — changing it requires rebuilding the frontend.
#
# Local docker-compose dev: http://localhost:8000
# Production: the publicly reachable URL of your deployed titiler instance.
PUBLIC_TITILER_URL=http://localhost:8000
